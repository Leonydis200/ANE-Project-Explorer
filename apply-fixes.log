            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -20 }}
            className="space-y-4"
          >
            <h2 className="text-2xl font-bold text-primary">{steps[step].title}</h2>
            <p className="text-gray-600 dark:text-gray-300">{steps[step].content}</p>
            
            {/* Step-specific content */}
            {step === 0 && (
              <input
                type="text"
